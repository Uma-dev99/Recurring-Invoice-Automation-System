# Copy to backend/.env and adjust. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send CSRF-protected requests (the Vite dev server).
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=invoice_automation
POSTGRES_USER=invoice_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Celery broker + shared cache). Start it with: docker compose up -d redis
REDIS_URL=redis://localhost:6380

# Business time zone that decides which calendar day a billing date falls on.
BILLING_TIME_ZONE=Europe/Amsterdam

DJANGO_LOG_LEVEL=INFO
