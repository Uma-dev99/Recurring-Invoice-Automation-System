# Production configuration template. Copy to .env.prod, fill in real values, and keep
# .env.prod out of git (it is ignored) and readable only by the deploy user.
# Every variable is explained in docs/deployment.md.

# --- Django -----------------------------------------------------------------------------
# 50+ random characters. Generate:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# The public host name(s) of the site, comma separated. No '*'.
DJANGO_ALLOWED_HOSTS=billing.example.com
# The full origin(s) the browser uses, with https://
DJANGO_CSRF_TRUSTED_ORIGINS=https://billing.example.com
# Proxies in front of Django: 1 = nginx only; 2 = a load balancer in front of nginx.
DJANGO_NUM_PROXIES=2
# true when a proxy in front terminates TLS and sets X-Forwarded-Proto (normal setup).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=json
APP_VERSION=1.0.0

# --- Database ---------------------------------------------------------------------------
POSTGRES_DB=invoice_automation
POSTGRES_USER=invoice_app
POSTGRES_PASSWORD=

# --- Billing ----------------------------------------------------------------------------
BILLING_TIME_ZONE=Europe/Amsterdam
# Fake gateway until the Riverty adapter exists (Phase 6). Do NOT go live with it.
INVOICE_GATEWAY=apps.invoicing.gateway.FakeGateway
INVOICE_MAX_ATTEMPTS=5

# --- Processes --------------------------------------------------------------------------
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2
WEB_PORT=8080
